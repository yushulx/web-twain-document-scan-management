# Copy to .env.demo.local and fill in before `npm run build:demo`.
# The DDV key used by /codepool/demos/ is bound to www.dynamsoft.com, so it
# only activates on the deployed site (local builds use the trial key).
VITE_DDVR_LICENSE="your-document-viewer-license"
VITE_DWT_LICENSE="your-dynamic-web-twain-license"
VITE_GDRIVE_CLIENT_ID=""
